{
  "name": "quality-critical-azure-lakehouse-portfolio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "sync:content": "node scripts/sync-content.mjs",
    "build:architecture": "node scripts/build-architecture.mjs",
    "build:evidence-visuals": "node scripts/build-evidence-visuals.mjs",
    "build:manifest": "node scripts/build-evidence-manifest.mjs",
    "build:pdf": "node scripts/build-pdf.mjs",
    "build:site": "vite build",
    "build": "npm run sync:content && npm run build:architecture && npm run build:evidence-visuals && npm run build:manifest && npm run build:pdf && npm run build:site",
    "check:content": "node scripts/validate-content.mjs",
    "scan:publication": "node scripts/publication-scan.mjs",
    "check:pdf": "node scripts/validate-pdf.mjs",
    "test:site": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run check:content && npm run scan:publication && npm run build && npm run check:pdf && npm run test:site",
    "dev": "vite"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.62.0",
    "@types/node": "26.1.2",
    "ajv": "8.20.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.2.108",
    "sharp": "0.35.3",
    "typescript": "7.0.2",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  }
}
